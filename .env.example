# Copier en .env (jamais versionné) et adapter. Sous PowerShell, définir plutôt : $env:DB_PASSWORD = "..."
# PostgreSQL (étape charger_base). Dans un futur conteneur Compose : DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=remplacer-par-votre-mot-de-passe

