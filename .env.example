# Copier en .env :  cp .env.example .env
COMPOSE_PROJECT_NAME=llm-stack

POSTGRES_DB=llmapp
POSTGRES_USER=llmapp

# Modèle servi par llama.cpp (service llm) ; llm-init télécharge depuis Hugging Face, une seule fois,
# le modèle LLM_QUANT et son module de vision dans le volume llm_models.
LLAMACPP_VERSION=b11434
LLM_MODEL=qwen3-vl-4b-instruct
LLM_HF_REPO=Qwen/Qwen3-VL-4B-Instruct-GGUF
LLM_QUANT=Q4_K_M
LLM_CTX=4096
LLM_THREADS=4
LLM_CPUS=4.0
LLM_MEMORY=12G
LLM_TIMEOUT=300

WEB_PORT=8080
LOG_LEVEL=INFO
APP_VERSION=dev

# Pour la sauvegarde (profil backup) sous Linux/macOS : id -u / id -g
HOST_UID=1000
HOST_GID=1000

# ---------- Assistant et scanner (src/nutriscope/assistant, src/nutriscope/scanner) ----------
# llamacpp (défaut : le service llm de la stack, modèle LLM_MODEL), ollama ou api (OpenRouter, Mistral...)
LLM_PROVIDER=llamacpp
# Serveur llama.cpp publié sur l'hôte par compose.override.yml
LLAMACPP_HOST=http://localhost:8081
# Avec LLM_PROVIDER=ollama : serveur Ollama et modèles
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
# "none" désactive la réflexion de qwen3 (Ollama, API) ; vide pour la garder
LLM_REASONING_EFFORT=none
# API_BASE_URL=https://openrouter.ai/api/v1
# API_KEY=                      # jamais dans le dépôt : uniquement dans .env
# API_CHAT_MODEL=qwen/qwen3-8b
# API_VISION_MODEL=qwen/qwen3-vl-8b-instruct
# API_PRICE_INPUT=0.25          # $ par million de tokens
# API_PRICE_OUTPUT=0.75

# Scanner : lectures par photo, modèles (séparés par des virgules), relances, taille max de l'image
SCANNER_READS=1
# SCANNER_MODELS=qwen3-vl-4b-instruct   # avec llama.cpp, un seul modèle servi : celui de LLM_MODEL
SCANNER_RETRIES=1
SCANNER_MAX_SIDE=1200

# Catalogue PostgreSQL (pipeline) : base "nutriscope" d'options.ini, sinon NUTRISCOPE_DB
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# NUTRISCOPE_DB=nutriscope
