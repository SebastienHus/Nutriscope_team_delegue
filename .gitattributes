# Par défaut : Git détecte le texte et le stocke en LF
* text=auto

# Scripts Windows : garder CRLF
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Sources
# =========
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python
*.pyi    text diff=python

# Binaires
# =========
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary
*.parquet binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.pdf     binary
